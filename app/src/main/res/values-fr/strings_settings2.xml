    <!-- SyncSettingsScreen.kt -->
    <string name="settings2_sync_sign_in_failed">Connexion annulée ou échouée.</string>
    <string name="settings2_sync_signed_in_as">Connecté en tant que %1$s</string>
    <string name="settings2_sync_drive_auth_failed">Échec de l\'autorisation Drive.</string>
    <string name="settings2_sync_signed_out">Déconnecté de Drive.</string>
    <string name="settings2_sync_drive_header">Synchronisation Drive</string>
    <string name="settings2_sync_drive_footer">Les playlists, la progression de lecture, les rappels, les préférences de l\'app et les identifiants se synchronisent via votre dossier AppData de Drive. Ces fichiers sont propres à l\'app et n\'apparaissent jamais dans l\'interface principale de Drive.</string>
    <string name="settings2_sync_enabled">Synchronisation activée</string>
    <string name="settings2_sync_enabled_subtitle_signed_in">Synchronisation automatique des catégories activées ci-dessous.</string>
    <string name="settings2_sync_enabled_subtitle_signed_out">Connectez-vous ci-dessous, puis activez la synchronisation pour envoyer et récupérer vos données.</string>
    <string name="settings2_sync_categories_header">Catégories</string>
    <string name="settings2_sync_categories_footer">Choisissez ce qui se synchronise entre vos appareils. La synchronisation s\'exécute automatiquement environ toutes les 6 heures en Wi-Fi, si la batterie n\'est pas faible. Utilisez Envoyer ou Récupérer ci-dessous pour la lancer immédiatement.</string>
    <string name="settings2_sync_remote_map">Configuration des touches</string>
    <string name="settings2_sync_remote_map_subtitle">Fait partie des préférences de l\'app. Désactivez-la sur un appareil dont la télécommande diffère des autres. Ce choix reste sur cet appareil et n\'est pas partagé.</string>
    <string name="settings2_sync_actions_header">Actions</string>
    <string name="settings2_sync_actions_footer">Envoyer remplace la sauvegarde Drive par cet appareil ; Récupérer remplace cet appareil par la sauvegarde. Dernier envoi : %1$s. Dernière récupération : %2$s.</string>
