    <!-- DvrSettingsScreen.kt -->
    <string name="settings2_dvr_title">Paramètres d\'enregistrement</string>
    <string name="settings2_dvr_destination_header">Destination par défaut</string>
    <string name="settings2_dvr_destination_footer">Emplacement des nouveaux enregistrements, sauf si vous le changez dans la fenêtre d\'enregistrement. Les comptes sans enregistrement sur serveur enregistrent toujours sur cet appareil.</string>
    <string name="settings2_dvr_destination_server">Serveur (Dispatcharr)</string>
    <string name="settings2_dvr_buffers_header">Marges d\'enregistrement par défaut</string>
    <string name="settings2_dvr_buffers_footer">Les marges prolongent les nouveaux enregistrements au-delà du créneau prévu. Les enregistrements existants ne sont pas modifiés. Utile pour le sport et les directs qui débordent.</string>
    <string name="settings2_dvr_start_early">Commencer plus tôt</string>
    <string name="settings2_dvr_end_late">Finir plus tard</string>
    <string name="settings2_dvr_commercial_header">Coupures publicitaires</string>
    <string name="settings2_dvr_commercial_footer">Pour les enregistrements serveur dont Comskip a marqué les coupures (Comskip de Dispatcharr en mode Mark). L\'enregistrement n\'est jamais coupé, une erreur ne coûte donc rien : après un saut automatique, appuyez sur Gauche pour revenir en arrière.</string>
    <string name="settings2_dvr_commercial_auto">Passer automatiquement</string>
    <string name="settings2_dvr_commercial_button">Afficher un bouton Passer la pub</string>
    <string name="settings2_dvr_commercial_off">Les lire</string>
    <string name="settings2_dvr_server_header">Enregistrements serveur</string>
    <string name="settings2_dvr_server_footer">Si Comskip est configuré sur le serveur, Dispatcharr le lance à la fin de l\'enregistrement et coupe les publicités trouvées. Les règles de séries utilisent les marges et réglages Comskip du serveur.</string>
    <string name="settings2_dvr_comskip_toggle">Marquer les publicités (Comskip)</string>
    <string name="settings2_dvr_comskip_subtitle">Comskip sur les nouveaux enregistrements serveur. En mode Mark, il marque seulement les coupures à sauter ; en mode Cut, il les supprime, et une erreur coupe une partie du programme.</string>
    <string name="settings2_dvr_local_header">Stockage local</string>
    <string name="settings2_dvr_local_footer">La limite s\'applique uniquement aux enregistrements locaux de cet appareil. Les enregistrements serveur restent sur Dispatcharr et y sont suivis.</string>
    <string name="settings2_dvr_maximum">Maximum</string>
    <string name="settings2_dvr_storage_used">%1$s utilisés sur %2$s</string>
    <string name="settings2_dvr_location_header">Emplacement de stockage</string>
    <string name="settings2_dvr_location_footer">Par défaut, les enregistrements locaux vont dans votre dossier Téléchargements (sous-dossier AerioTV), visible dans n\'importe quel gestionnaire de fichiers. Choisir un dossier définit un autre emplacement via le Storage Access Framework, conservé après redémarrage.</string>
    <string name="settings2_dvr_currently_saving">Enregistrement actuel dans :</string>
    <string name="settings2_dvr_default_folder">Téléchargements de l\'appareil (dossier AerioTV)</string>
    <string name="settings2_dvr_choose_folder">Choisir un dossier</string>
    <string name="settings2_dvr_reset_default">Rétablir par défaut</string>
    <string name="settings2_dvr_behavior_header">Comportement</string>
    <string name="settings2_dvr_behavior_footer">Maintient le processeur éveillé pendant le téléchargement d\'un enregistrement local pour que le mode Doze ne le bloque pas. Les enregistrements côté serveur ne sont pas concernés (ils tournent sur Dispatcharr). Laissez activé, sauf pour diagnostiquer la consommation de batterie.</string>
    <string name="settings2_dvr_keep_awake">Garder l\'appareil éveillé pendant l\'enregistrement</string>
    <string name="settings2_dvr_keep_awake_subtitle">Recommandé pour les longs enregistrements locaux.</string>
    <string name="settings2_dvr_roll_minutes">%1$d min</string>
    <string name="settings2_dvr_storage_gb">%1$d Go</string>
    <string name="settings2_dvr_storage_gb_decimal">%1$.1f Go</string>
    <string name="settings2_dvr_storage_mb">%1$d Mo</string>

