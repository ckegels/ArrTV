    <string name="settings2_updates_auto_header">Vérifications automatiques</string>
    <string name="settings2_updates_auto_footer">Activé, AerioTV recherche une nouvelle version à l\'ouverture et vous la propose. Désactivé : rien n\'est vérifié tant que vous n\'appuyez pas sur Rechercher des mises à jour.</string>
    <string name="settings2_updates_auto_toggle">Rechercher automatiquement les mises à jour</string>
