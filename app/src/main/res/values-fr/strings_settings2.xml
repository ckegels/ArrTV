    <string name="settings2_updates_ready_header">Prêt à installer</string>
    <string name="settings2_updates_ready_footer">Vos données sont conservées. AerioTV va se fermer pour l\'installation ; rouvrez-le depuis l\'écran d\'accueil.</string>
