    <!-- SyncSettingsScreen.kt -->
    <string name="settings2_sync_sign_in_failed">Sign-in cancelled or failed.</string>
    <string name="settings2_sync_signed_in_as">Signed in as %1$s</string>
    <string name="settings2_sync_drive_auth_failed">Drive authorization failed.</string>
    <string name="settings2_sync_signed_out">Signed out of Drive.</string>
    <string name="settings2_sync_drive_header">Drive Sync</string>
    <string name="settings2_sync_drive_footer">Playlists, watch progress, reminders, app preferences and credentials sync via your Drive AppData folder. Files are scoped per-app and never appear in your main Drive UI.</string>
    <string name="settings2_sync_enabled">Sync enabled</string>
    <string name="settings2_sync_enabled_subtitle_signed_in">Auto-syncing the categories you\'ve toggled below.</string>
    <string name="settings2_sync_enabled_subtitle_signed_out">Sign in below, then enable sync to push and pull data.</string>
    <string name="settings2_sync_categories_header">Categories</string>
    <string name="settings2_sync_categories_footer">Choose what syncs across your devices. Syncing runs automatically about every 6 hours while you are on Wi-Fi and the battery is not low. Use Push or Pull below when you want it to happen right now.</string>
    <string name="settings2_sync_remote_map">Remote Button Map</string>
    <string name="settings2_sync_remote_map_subtitle">Part of App Preferences. Turn off on a device whose remote differs from your others. This choice stays on this device and is not shared.</string>
    <string name="settings2_sync_actions_header">Actions</string>
    <string name="settings2_sync_actions_footer">Push overwrites the Drive backup with this device; Pull overwrites this device with the backup. Last Push: %1$s. Last Pull: %2$s.</string>
    <string name="settings2_sync_never">never</string>
    <string name="settings2_sync_push">Push Config to Drive</string>
    <string name="settings2_sync_push_subtitle">Overwrite the Drive backup with this device\'s setup</string>
    <string name="settings2_sync_pull">Pull Config from Drive</string>
    <string name="settings2_sync_pull_subtitle">Overwrite this device with the Drive backup</string>
    <string name="settings2_sync_clear">Clear Drive Data</string>
    <string name="settings2_sync_push_confirm_title">Push Config to Drive?</string>
    <string name="settings2_sync_push_confirm_text">This replaces the entire Drive backup with this device\'s current configuration. Other devices that pull later receive this copy.</string>
    <string name="settings2_sync_push_confirm_button">Push to Drive</string>
    <string name="settings2_sync_pull_confirm_title">Pull Config from Drive?</string>
    <string name="settings2_sync_pull_confirm_text">This replaces this device\'s playlists, preferences, and watch progress with the Drive backup. The current setup on this device is overwritten.</string>
    <string name="settings2_sync_pull_confirm_button">Pull from Drive</string>
    <string name="settings2_sync_creds_title">Credentials sync to your Drive</string>
    <string name="settings2_sync_creds_text">So your servers restore automatically on another device, AerioTV includes each server\'s sign-in details (username, password, and API key) in the Drive backup. These files live in your own Google Drive app data, are reachable only by AerioTV, and never appear in your Drive UI, but they are stored without an extra password. On this device the same credentials are encrypted at rest.\n\nYou can turn this off any time with the Credentials toggle below.</string>
    <string name="settings2_sync_got_it">Got it</string>
    <string name="settings2_sync_not_set_up">Drive Sync isn\'t set up yet</string>
    <string name="settings2_sync_not_configured_text">This AerioTV build doesn\'t have a Google Cloud OAuth Web Client ID baked in, so the Sign in with Google sheet can\'t load.\n\nTo enable Drive Sync on your own build, create an OAuth Web Client ID in Google Cloud Console, register the signing-cert SHA-1 of this APK as an Android Client in the same project, then add the line GOOGLE_DRIVE_WEB_CLIENT_ID=&lt;your-id&gt; to local.properties before rebuilding.</string>
    <string name="settings2_sync_welcome_text">Select Sign in with Google below to connect your account. AerioTV will then keep your playlists, watch progress, reminders, and preferences in sync across every device signed into the same Google account.</string>
    <string name="settings2_sync_dev_config_hint">This build doesn\'t have a Google Cloud OAuth client configured, so Sign in with Google is disabled. Add GOOGLE_DRIVE_WEB_CLIENT_ID to local.properties and register the signing-cert SHA-1 in the same Cloud project.</string>
