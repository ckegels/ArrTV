    <string name="tutorial_basics_title">Your remote</string>
    <string name="tutorial_basics_intro">Everything in the app works with these few buttons. “Hold” means keep the button pressed for about a second.</string>
    <string name="tutorial_basics_arrows">Move around the screen</string>
    <string name="tutorial_basics_ok">Choose, confirm, play</string>
