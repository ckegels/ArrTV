    <string name="tutorial_guide_title">In the guide</string>
    <string name="tutorial_guide_intro">The guide lists every channel with what is on now and later.</string>
    <string name="tutorial_guide_updown">Move between channels</string>
    <string name="tutorial_guide_leftright_time">Move earlier or later in time</string>
    <string name="tutorial_guide_back">Back to the top channel</string>
    <string name="tutorial_watch_title">While watching</string>
    <string name="tutorial_watch_intro">A channel plays full screen; the buttons below work without anything on screen.</string>
    <string name="tutorial_watch_back">Shrink to a small player in a corner and browse</string>
    <string name="tutorial_watch_back_twice">Stop watching</string>
    <string name="tutorial_controls_title">Player controls</string>
    <string name="tutorial_controls_intro">Press OK while watching to show the program details and the controls.</string>
    <string name="tutorial_controls_leftright">Move along the row: TV guide, history and the other channels</string>
    <string name="tutorial_controls_ok">Use the selected button</string>
    <string name="tutorial_controls_down">Row with TV guide, history and the next channels</string>
